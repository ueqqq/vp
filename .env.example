# Values here are only the STARTING defaults. After first run, change them in Discord with /castro settings.
# Copy to .env and fill in. Never commit .env.
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional
# GUILD_ID=123456789012345678     # sync slash commands to one server instantly while developing
# VOTE_GOAL=250
# SCRAPE_INTERVAL_SECONDS=30      # normal polling, minimum 10
# FAST_INTERVAL_SECONDS=15        # polling once the party is close, minimum 10
# PING_THRESHOLD=30
# QUOTE_TZ=America/Chicago        # when "8:00 AM" is; default UTC
# QUOTE_HOUR=8
# DATA_DIR=data
